NODE_ENV=production
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
JWT_SECRET=<long-random-secret>
FRONTEND_URLS=https://<your-frontend-domain>

# Required only for admin room image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional, only if your host needs custom DNS resolvers for MongoDB SRV
# DNS_SERVERS=1.1.1.1,8.8.8.8
